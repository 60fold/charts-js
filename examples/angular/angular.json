{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "wrapper-demo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "outputPath": "dist",
            "assets": [
              { "glob": "**/*", "input": "../../packages/line/dist/assets", "output": "assets" },
              { "glob": "**/*", "input": "../../packages/stock/dist/assets", "output": "assets" }
            ],
            "styles": ["src/styles.css"],
            "tsConfig": "tsconfig.app.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": { "development": { "buildTarget": "wrapper-demo:build" } },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
